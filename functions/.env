# Production settings for the Cloud Functions (deployed with them). Not secret.

# E-mail addresses that may activate admin access (Admin → "Activate admin access").
# Comma-separated. Only verified e-mails (e.g. Google sign-in) are accepted.
ADMIN_EMAILS=

# Public site URL for links in e-mails and share previews. Leave empty to use
# https://<project-id>.web.app; set to https://ajay.at once the domain is connected.
SITE_ORIGIN=

# App Check (reCAPTCHA Enterprise) for the forms. Set to true only after App Check is
# set up in the Firebase console AND VITE_RECAPTCHA_ENTERPRISE_SITE_KEY is in web/.env.production.
ENFORCE_APP_CHECK=false

# Guest list before each event: sent GUESTLIST_DIGEST_HOURS (default 6) hours before the start to
# GUESTLIST_EMAILS (comma-separated; empty = ADMIN_EMAILS).
GUESTLIST_EMAILS=
GUESTLIST_DIGEST_HOURS=6
