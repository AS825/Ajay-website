rules_version = '2';

// Phase 1 rules. Public data is read-only; all user writes will go through
// Cloud Functions (Phase 4). Admin writes are added in Phase 5.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /settings/{docId} {
      allow read: if docId in ['site', 'theme'] || isAdmin();
      allow write: if isAdmin();
    }

    match /links/{id} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();

      match /{sub=**} {
        allow read, write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
