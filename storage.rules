rules_version = '2';

// Public read for site media. Uploads only by admins, with type and size limits
// per folder (SPEC §12). Paths: media/images/**, media/videos/**, media/docs/**.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    match /media/images/{path=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif|gif|svg\\+xml)');
    }

    match /media/videos/{path=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }

    match /media/docs/{path=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
  }
}
