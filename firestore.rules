rules_version = '2';

// Public data is read-only. Visitors write only through Cloud Functions
// (joinGuestlist, submitBooking). Admins (custom claim admin == true) manage
// everything from /admin. SPEC §12.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    match /settings/{docId} {
      allow read: if docId in ['site', 'theme'] || isAdmin();
      allow write: if isAdmin();
    }

    match /links/{id} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();

      // Guestlist entries (and later ticket types) – admin only.
      match /{sub=**} {
        allow read, write: if isAdmin();
      }
    }

    // bookings, mail, rateLimits and anything else: admin only.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
