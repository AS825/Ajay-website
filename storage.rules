rules_version = '2';

// Public read for site media; uploads are admin-only (Phase 5 adds type/size limits per folder).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
